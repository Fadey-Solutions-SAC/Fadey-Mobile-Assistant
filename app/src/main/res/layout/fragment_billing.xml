<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fadey_bg"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Certificado SUNAT (.pfx)"
            android:textColor="@color/fadey_navy"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtCertStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/fadey_text_secondary"
            android:textSize="15sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Contraseña del archivo .pfx"
            android:textColor="@color/fadey_text_secondary"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/editPfxPassword"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Contraseña del .pfx"
            android:inputType="textPassword"
            android:textColor="@color/fadey_navy"
            android:textColorHint="@color/fadey_hint" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnImportPfx"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Importar certificado .pfx" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnClearPfx"
            style="@style/Widget.Fadey.Button.Outlined"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Borrar certificado" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="El .pfx se guarda cifrado en el teléfono (nunca en el APK). También puede llegar pfx_base64 desde el servidor POS al emitir (pending-local)."
            android:textColor="@color/fadey_text_secondary"
            android:textSize="13sp" />
    </LinearLayout>
</ScrollView>
