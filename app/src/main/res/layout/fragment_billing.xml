<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fadey_bg"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Certificado SUNAT"
            android:textColor="@color/fadey_navy"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Igual que el asistente de PC: el .pfx ya está en el sistema (panel de facturación). Al reclamar un comprobante el servidor envía pfx_base64 + clave. No hace falta importarlo en el teléfono."
            android:textColor="@color/fadey_text_secondary"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/txtCertStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textColor="@color/fadey_navy"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Reserva (opcional)"
            android:textColor="@color/fadey_navy"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Solo si el servidor no puede embeber el certificado. Contraseña del .pfx:"
            android:textColor="@color/fadey_text_secondary"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/editPfxPassword"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Contraseña del .pfx (opcional)"
            android:inputType="textPassword"
            android:textColor="@color/fadey_navy"
            android:textColorHint="@color/fadey_hint" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnImportPfx"
            style="@style/Widget.Fadey.Button.Outlined"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Importar .pfx local (opcional)" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnClearPfx"
            style="@style/Widget.Fadey.Button.Outlined"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Borrar certificado local" />
    </LinearLayout>
</ScrollView>
