<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fadey_bg"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Vínculo con el servidor POS"
            android:textColor="@color/fadey_navy"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="El asistente móvil usa los mismos datos del sistema (impresiones y e-fact en cola). Sin este vínculo no recibe trabajos desde internet."
            android:textColor="@color/fadey_text_secondary"
            android:textSize="14sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="1. Inicie sesión en el POS como cajero/admin.\n2. URL API (misma del sistema, termina en /api).\n3. Token JWT del login (Local Storage → token)."
            android:textColor="@color/fadey_navy"
            android:textSize="14sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="URL del API"
            android:textColor="@color/fadey_text_secondary"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/editApiBase"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="https://su-servidor.onrender.com/api"
            android:inputType="textUri"
            android:textColor="@color/fadey_navy"
            android:textColorHint="@color/fadey_hint" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Token JWT (cajero / admin)"
            android:textColor="@color/fadey_text_secondary"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/editToken"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="eyJhbGciOi…"
            android:inputType="textPassword"
            android:textColor="@color/fadey_navy"
            android:textColorHint="@color/fadey_hint" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSaveLink"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="Guardar vínculo con el servidor" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnUnlink"
            style="@style/Widget.Fadey.Button.Outlined"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Desvincular (borra token y certificado)" />

        <TextView
            android:id="@+id/txtSettingsMsg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textColor="@color/fadey_navy"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>
</ScrollView>
